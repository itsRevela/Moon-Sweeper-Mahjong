<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev tool: writes "RVA<TAB>Type$$Method" for every method with code, so Ghidra output shows real names. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- tools/Cpp2IL is a local clone of SamboyCoding/Cpp2IL (development, b5ad444); see docs/loader.md. -->
    <ProjectReference Include="..\..\tools\Cpp2IL\LibCpp2IL\LibCpp2IL.csproj" />
  </ItemGroup>

</Project>
