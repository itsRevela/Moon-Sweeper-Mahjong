bin/
obj/
*.user
.vs/

# Local runtime state
.run/

# Generated plugin assets (scripts/prepare_assets.py)
build/

# Release builds (scripts/package_release.py)
dist/

# Python caches
__pycache__/
*.pyc
.pytest_cache/
