+    // A Cpp2IL CLI placed here runs out of process instead of the bundled Cpp2IL.Core. Newer Cpp2IL builds read newer
+    // IL2CPP metadata (v107+, Unity 6000.5+) but are built against a newer AsmResolver than Il2CppInterop, so they
+    // cannot share this process; their dummy assemblies are exchanged through files instead.
+    private static string ExternalCpp2IlPath => Path.Combine(Paths.BepInExRootPath, "cpp2il", "Cpp2IL.exe");
+
+    private static string ExternalCpp2IlOutputPath => Path.Combine(Paths.CachePath, "cpp2il-dummy");
+
+    private static readonly Regex AnsiEscape = new(@"\x1B\[[0-9;]*m", RegexOptions.Compiled);
+
+    private static List<AsmResolver.DotNet.AssemblyDefinition> RunExternalCpp2Il(string metadataPath,
+        ManualLogSource cpp2IlLogger)
+    {
+        Logger.LogMessage($"Using external Cpp2IL at {ExternalCpp2IlPath}");
+
+        if (Directory.Exists(ExternalCpp2IlOutputPath))
+            Directory.Delete(ExternalCpp2IlOutputPath, true);
+        Directory.CreateDirectory(ExternalCpp2IlOutputPath);
+
+        var startInfo = new ProcessStartInfo(ExternalCpp2IlPath)
+        {
+            UseShellExecute = false,
+            RedirectStandardOutput = true,
+            RedirectStandardError = true,
+            CreateNoWindow = true,
+            WorkingDirectory = Path.GetDirectoryName(ExternalCpp2IlPath)!,
+        };
+        foreach (var argument in new[]
+                 {
+                     "--force-binary-path", GameAssemblyPath,
+                     "--force-metadata-path", metadataPath,
+                     "--force-unity-version", UnityInfo.Version.ToString(),
+                     "--use-processor", "attributeinjector",
+                     "--output-as", "dll_default",
+                     "--output-to", ExternalCpp2IlOutputPath,
+                 })
+            startInfo.ArgumentList.Add(argument);
+
+        using var process = new Process { StartInfo = startInfo };
+        process.OutputDataReceived += (_, e) => LogExternalLine(cpp2IlLogger, e.Data, false);
+        process.ErrorDataReceived += (_, e) => LogExternalLine(cpp2IlLogger, e.Data, true);
+        if (!process.Start())
+            throw new InvalidOperationException($"Could not start {ExternalCpp2IlPath}");
+        process.BeginOutputReadLine();
+        process.BeginErrorReadLine();
+        process.WaitForExit();
+
+        if (process.ExitCode != 0)
+            throw new InvalidOperationException($"External Cpp2IL exited with code {process.ExitCode}; see the Cpp2IL lines above");
+
+        var files = Directory.GetFiles(ExternalCpp2IlOutputPath, "*.dll");
+        if (files.Length == 0)
+            throw new InvalidOperationException($"External Cpp2IL wrote no assemblies to {ExternalCpp2IlOutputPath}");
+
+        return files.Select(AsmResolver.DotNet.AssemblyDefinition.FromFile).ToList();
+    }
+
+    private static void LogExternalLine(ManualLogSource logger, string line, bool isError)
+    {
+        if (string.IsNullOrWhiteSpace(line))
+            return;
+        var text = AnsiEscape.Replace(line, "").Trim();
+        if (isError || text.StartsWith("[Error]", StringComparison.Ordinal))
+            logger.LogError(text);
+        else if (text.StartsWith("[Warn]", StringComparison.Ordinal))
+            logger.LogWarning(text);
+        else
+            logger.LogInfo(text);
+    }
+
     private static void RunIl2CppInteropGenerator(List<AsmResolver.DotNet.AssemblyDefinition> sourceAssemblies)
     {
         var opts = new GeneratorOptions
